{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Joint item: a bill, letter, order or lawsuit several people share",
  "type": "object",
  "required": ["id", "title", "date", "type", "arena", "people", "source"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$" },
    "type": { "enum": ["bill", "letter", "coalition", "hearing", "lawsuit"] },
    "arena": { "enum": ["federal", "state"] },
    "people": { "type": "array", "items": { "type": "string" } },
    "source": { "type": "string", "pattern": "^https?://" }
  }
}
