{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": { "enum": ["unreviewed", "reviewed"] },
    "by": { "type": "string" },
    "date": { "type": "string" },
    "note": { "type": "string" }
  }
}
