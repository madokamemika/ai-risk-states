{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Statement",
  "type": "object",
  "required": ["date", "arena", "kind", "text", "source"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$" },
    "arena": { "enum": ["federal", "state"] },
    "kind": { "enum": ["quote", "urging", "action"] },
    "text": { "type": "string", "minLength": 3 },
    "target": { "type": ["string", "null"] },
    "joint": { "type": ["string", "null"] },
    "source": { "type": "string", "pattern": "^https?://" },
    "outlet": { "type": ["string", "null"] }
  }
}
