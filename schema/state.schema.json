{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "State",
  "type": "object",
  "required": ["code", "xrisk", "summary", "items", "review"],
  "properties": {
    "code": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "xrisk": { "enum": ["acted", "direct", "adjacent", "none"] },
    "summary": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "type", "title", "source"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$" },
          "type": { "enum": ["law", "bill", "lawsuit", "executive_order", "letter", "statement", "veto"] },
          "title": { "type": "string" },
          "status": { "type": "string" },
          "text": { "type": "string" },
          "source": { "type": "string", "pattern": "^https?://" },
          "people": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "profile": {
      "type": "object",
      "properties": {
        "headline": { "type": "string" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["topic", "text", "sources"],
            "properties": {
              "topic": { "enum": ["state_push", "compute", "pushback", "universities", "congress"] },
              "text": { "type": "string" },
              "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string", "pattern": "^https?://" }, "outlet": { "type": "string" } } } }
            }
          }
        }
      }
    },
    "review": { "$ref": "review.schema.json" }
  }
}
